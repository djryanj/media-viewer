{
    "name": "media-viewer-svelte",
    "version": "0.19.2",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "lint": "eslint src --ext .ts,.svelte && prettier --check src",
        "lint:js": "eslint src --ext .ts,.svelte",
        "lint:fix": "eslint src --ext .ts,.svelte --fix",
        "format": "prettier --write src",
        "format:check": "prettier --check src",
        "test": "npm run test:unit && npm run test:e2e",
        "test:unit": "vitest run",
        "test:unit:only": "vitest run",
        "test:unit:watch": "vitest",
        "test:unit:coverage": "vitest run --coverage",
        "test:integration": "vitest run --reporter=verbose",
        "test:e2e": "PLAYWRIGHT_HTML_OPEN=never playwright test --project=chromium",
        "test:e2e:smoke": "PLAYWRIGHT_HTML_OPEN=never playwright test --project=chromium --grep @smoke",
        "test:e2e:runtime-smoke": "PLAYWRIGHT_HTML_OPEN=never playwright test --project=chromium --grep @smoke",
        "test:e2e:visual": "PLAYWRIGHT_HTML_OPEN=never playwright test --project=chromium-visual",
        "test:e2e:visual:baselines": "PLAYWRIGHT_HTML_OPEN=never playwright test --project=chromium-visual --update-snapshots",
        "test:e2e:docs-screenshots": "PLAYWRIGHT_HTML_OPEN=never playwright test --project=chromium-screenshots",
        "test:e2e:headed": "playwright test --headed --project=chromium",
        "test:e2e:debug": "playwright test --debug"
    },
    "devDependencies": {
        "@playwright/test": "^1.48.0",
        "@sveltejs/adapter-static": "^3.0.8",
        "@sveltejs/kit": "^2.21.0",
        "@sveltejs/vite-plugin-svelte": "^7.0.0",
        "@testing-library/svelte": "^5.3.1",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "@vitest/coverage-v8": "^4.0.0",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-svelte": "^3.0.0",
        "globals": "^17.0.0",
        "happy-dom": "^20.0.0",
        "prettier": "^3.4.0",
        "prettier-plugin-svelte": "^4.0.0",
        "svelte": "^5.46.4",
        "svelte-check": "^4.1.6",
        "typescript": "^5.7.2",
        "vite": "^8.0.0",
        "vitest": "^4.0.0"
    },
    "dependencies": {
        "hls.js": "^1.6.16"
    }
}
